# Скопируйте в .env и заполните нужные значения.
# Все переменные необязательны: без них приложение работает в демо-режиме.

# Постоянный секрет cookie (обязателен в продакшене).
SECRET_KEY=change-me-to-a-long-random-string

# Путь к базе SQLite.
DATABASE_PATH=instance/tracker.db

# Демо-режим.
ALLOW_DEMO_LOGIN=true
SEED_DEMO=true
DOCS_PUBLIC=true

# Фоновый планировщик напоминаний (каждую минуту).
SCHEDULER_ENABLED=true

# Включите при работе через HTTPS.
SESSION_COOKIE_SECURE=false

# Telegram-бот (@BotFather).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# AI-провайдер, совместимый с OpenAI API.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=40
